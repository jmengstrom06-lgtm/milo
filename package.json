{
  "name": "milo",
  "version": "0.1.0",
  "private": true,
  "description": "Milo: an animated AI companion that lives on your screen",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,main,electron \"vite\" \"tsc -p tsconfig.main.json -w --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 dist/main/main.js && cross-env MILO_DEV=1 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "setkey": "node scripts/setkey.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run-router.ts",
    "check": "npm run typecheck && npm test",
    "pack": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "dotenv": "^16.4.5",
    "katex": "^0.19.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "productName": "Milo",
  "author": "Jake Engstrom",
  "build": {
    "appId": "app.milo.companion",
    "productName": "Milo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/trayTemplate*.png"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!config.json"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dir"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Milo listens when you talk to him.",
        "NSAppleEventsUsageDescription": "Milo opens apps, tabs and notes for you when you ask.",
        "NSScreenCaptureUsageDescription": "Milo looks at your screen to help with what you're working on."
      }
    }
  }
}
