{
  "manifest_version": 3,
  "name": "Milo",
  "version": "0.1.0",
  "description": "Lets Milo, your study buddy app for Mac, read and use web pages for you: opening assignments, filling forms, and finishing web tasks faster.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Milo",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
