{
  "manifest_version": 3,
  "name": "Milo",
  "version": "0.1.0",
  "description": "Lets Milo read and use web pages for you: faster, more reliable web tasks.",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon128.png" },
  "action": { "default_title": "Milo", "default_icon": { "128": "icon128.png" } }
}
