# Copy this file to .env and paste your key. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the model Milo uses
MILO_MODEL=claude-sonnet-5-5

# Milo's voice (ElevenLabs). Without it he uses the Mac's built-in voice.
ELEVENLABS_API_KEY=
# Optional: a different ElevenLabs voice id
MILO_VOICE_ID=
# Optional: faster model for deciding what you meant (default claude-haiku-5-5)
# MILO_ROUTER_MODEL=claude-haiku-5-5
# Deepgram Flux: smart listening (knows when you are done talking). Free $200 credit at deepgram.com
DEEPGRAM_API_KEY=
# OpenAI: images in Sketch ("show me what a plant cell looks like")
OPENAI_API_KEY=

# ---- Added Nov 2026 ----
# Accounts: sign in from the chat panel (Sign in chip). Signed in, Milo's brain, voice and ears run
# through the Milo backend (Supabase), so no keys are needed on the Mac. The keys above are only for development.
# MILO_SUPABASE_URL=https://ptfvptkhzxnpvdhgnfcp.supabase.co
# Fast model for quick chat, grading and memory (default claude-haiku-5-5)
# MILO_FAST_MODEL=claude-haiku-5-5
# Turn off crash reports + analytics (Sentry, PostHog). Nothing you say or see is ever sent.
# MILO_NO_TELEMETRY=1
# Turn off memory (Milo learning facts about you from chats)
# MILO_NO_MEMORY=1
# Use the old osascript hands instead of the native helper
# MILO_NO_NATIVE=1
