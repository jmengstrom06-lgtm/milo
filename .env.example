# Copy this file to .env and paste your key. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the model Milo uses
MILO_MODEL=claude-sonnet-5-5

# Milo's voice (ElevenLabs). Without it he uses the Mac's built-in voice.
ELEVENLABS_API_KEY=
# Optional: a different ElevenLabs voice id
MILO_VOICE_ID=
# Optional: faster model for deciding what you meant (default claude-haiku-5-5)
# MILO_ROUTER_MODEL=claude-haiku-5-5
# Deepgram Flux: smart listening (knows when you are done talking). Free $200 credit at deepgram.com
DEEPGRAM_API_KEY=
